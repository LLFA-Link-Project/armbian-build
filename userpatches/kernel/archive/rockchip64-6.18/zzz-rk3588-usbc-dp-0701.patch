From: OpenAI Codex <codex@openai.com>
Subject: [PATCH] arm64: dts: rockchip: Enable Orange Pi 5 USB-C DisplayPort

Enable DP Alt Mode on Orange Pi 5. Register a DisplayPort connector through the USB-DP PHY.

Hardware testing is pending.
---
diff --git a/arch/arm64/boot/dts/rockchip/rk3588s-orangepi-5.dts b/arch/arm64/boot/dts/rockchip/rk3588s-orangepi-5.dts
index 83b9b66..fa629b8 100644
--- a/arch/arm64/boot/dts/rockchip/rk3588s-orangepi-5.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3588s-orangepi-5.dts
@@ -30,3 +30,65 @@ &pcie2x1l2 {
 &sfc {
 	status = "okay";
 };
+
+&dp0 {
+	status = "okay";
+};
+
+&dp0_in {
+	dp0_in_vp2: endpoint {
+		remote-endpoint = <&vp2_out_dp0>;
+	};
+};
+
+&dp0_out {
+	dp0_out_phy: endpoint {
+		remote-endpoint = <&usbdp_phy0_dp_in>;
+	};
+};
+
+&usb_con {
+	altmodes {
+		dp {
+			svid = /bits/ 16 <0xff01>;
+			vdo = <0x00001c46>;
+		};
+	};
+};
+
+&usbdp_phy0 {
+	/delete-node/ port;
+
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@0 {
+			reg = <0>;
+			usbdp_phy0_typec_ss: endpoint {
+				remote-endpoint = <&usbc0_ss>;
+			};
+		};
+
+		port@2 {
+			reg = <2>;
+			usbdp_phy0_dp_in: endpoint {
+				remote-endpoint = <&dp0_out_phy>;
+			};
+		};
+
+		port@3 {
+			reg = <3>;
+			usbdp_phy0_typec_sbu: endpoint {
+				remote-endpoint = <&usbc0_sbu>;
+			};
+		};
+	};
+};
+
+&vp2 {
+	vp2_out_dp0: endpoint@a {
+		reg = <ROCKCHIP_VOP2_EP_DP0>;
+		remote-endpoint = <&dp0_in_vp2>;
+	};
+};
